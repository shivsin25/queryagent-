# Copy to .env and fill in. You need a key for the provider you choose (QT_LLM_PROVIDER):
# Groq (default, free): https://console.groq.com/keys
GROQ_API_KEY=

# --- LLM ---
# QT_LLM_PROVIDER=groq            # groq | gemini | openai | ollama
# OPENAI_API_KEY=                 # only for openai (paid; uv sync --extra openai)
# QT_PRIMARY_MODEL=llama-3.3-70b-versatile   # writer + reviewer
# QT_FAST_MODEL=llama-3.1-8b-instant         # rewriter + feedback + enhancer
# QT_TEMPERATURE=0.1
# GOOGLE_API_KEY=                 # only for QT_LLM_PROVIDER=gemini
# QT_REVIEWER_PROVIDER=groq       # review on another provider (needs that provider's key)
# QT_REVIEWER_MODEL=              # defaults to that provider's primary model
# QT_LLM_MAX_RETRIES=3            # each retry counts against free-tier daily quotas
# QT_MAX_OUTPUT_TOKENS=2048        # cap on every LLM reply

# --- Cost control ---
# QT_DAILY_BUDGET_USD=0.50         # new queries are refused once today's spend reaches it
# QT_MODEL_PRICES={"gpt-4.1-mini": [0.4, 1.6]}   # USD per 1M input/output tokens
# QT_CACHE_TTL_HOURS=168           # reuse approved answers; 0 turns the cache off
# QT_OLLAMA_BASE_URL=http://localhost:11434

# --- Retrieval ---
# QT_TOP_K=5
# QT_CANDIDATE_K=20
# QT_RERANK_ENABLED=true
# QT_CHUNK_SIZE=400                  # child chunks: searched and reranked
# QT_CHUNK_OVERLAP=80
# QT_PARENT_CHUNK_SIZE=1500          # parents: the section text the writer reads
# QT_MIN_RELEVANCE=-5.0              # best rerank score needed to answer; unset to disable
# QT_RERANK_MARGIN=3.0               # send only chunks this close to their query's best
# QT_MIN_CHUNK_SCORE=-7.0            # and never below this
# QT_RERANK_K=12                     # candidates the cross-encoder scores

# --- Agent loop ---
# QT_MAX_REVISIONS=2
# QT_APPROVAL_THRESHOLD=0.8
# QT_CLAIM_CHECK_ENABLED=true
# QT_CLAIM_SUPPORT_THRESHOLD=-4.0    # cited sentences scoring below this block approval
# QT_MAX_RESEARCH_ROUNDS=1           # follow-up searches for facts the reviewer found missing
# QT_RESEARCH_K=3                    # new chunks added per follow-up search

# --- Conversations ---
# QT_HISTORY_TURNS=3                 # earlier turns used to understand a follow-up question
# QT_MAX_RETRIES_PER_QUESTION=3      # "Try again" limit; each retry searches wider

# --- Services ---
# QT_API_URL=http://localhost:8000   # where the Streamlit UI finds the API
# QT_AUTO_SEED_SAMPLES=true          # index data/sample_docs when the store is empty
# QT_LOG_LEVEL=INFO
